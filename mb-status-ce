# size_span <bytes>: warn colour from 1G up, ok icon when (nearly) empty
size_span() {
    local h
    h=$(human "$1")
    if [[ $h == *[GT] || $h == *[GT]i ]]; then
        echo "<span bgcolor='${WARN_BGCOLOR}' fgcolor='${WARN_FGCOLOR}'> ${h} </span>"
    elif [[ $h == *K || $h == 0 ]]; then
        echo "<span fgcolor='${OK_FGCOLOR}'>   </span>"
    else
        echo "<span> ${h} </span>"
    fi
}

