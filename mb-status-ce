                item "$_ORPHANS" "<span> $ob </span>" orphans
                sub orphans "$_ORPHANS"
                local more=""
                ((nor > 3)) && more=" ..."
                info "$(cut -c1-35 <<<"$nor $_PKGS: ${PK[*]:0:3}$more")" "$_SIZE_INCL_DEPS"
            fi
            if ((nor > 0)); then
                opt "$_REVIEW_LIST" "pacman -Qi" orphans review
                opt "$_REMOVE_KEEP_CONFIGS" "pacman -R" orphans R
                opt "$_REMOVE_WITH_DEPS" "pacman -Rs" orphans Rs
                opt "$_BACKUP_THEN_REMOVE" "pacman -Rns" orphans backup
                bad "$_REMOVE_DEPS_CONFIGS" "pacman -Rns" orphans Rns
            fi
        fi

        local aurs=() aurdirs=()
        hash paru 2>/dev/null && aurs+=(paru) && aurdirs+=("$CE_CACHE/paru")
        hash yay 2>/dev/null && aurs+=(yay) && aurdirs+=("$CE_CACHE/yay")
        hash pamac 2>/dev/null && aurs+=(pamac) && aurdirs+=("/var/tmp/pamac-build-$USER")
        if ((${#aurs[@]})); then
            if ((!DYNAMIC)) || has_files "${aurdirs[@]}"; then
                aurb=$(bytes_of "${aurdirs[@]}")
                item "$_AUR_CACHE" "$(size_span "$aurb")" aur
                sub aur "$_AUR_CACHE"
                info "$_AUR_INFO"
                hash paru 2>/dev/null && opt "paru" "paru -Sc --aur" aur paru
                hash yay 2>/dev/null && opt "yay" "yay -Sc --aur" aur yay
                hash pamac 2>/dev/null && opt "pamac" "pamac clean -b" aur pamac
            fi
        fi

        if ((!DYNAMIC || sb > 0)) || has_files "$CE_CACHE/thumbnails"; then
            item "$_THUMBS_CACHE" "$(size_span "$sb")" cache
            sub cache "$_THUMBS_CACHE"
            info "$_CACHE_INFO1" "$_WHOLE_CACHE $(human "$cb")" "$_CACHE_INFO3"
            opt "$_OLD_THUMBS" "$_OLDER_THAN $(conf_days thumb_days 14) $_DAYS_AGO" thumbs
            opt "$_ALL_THUMBS ($(human "$thb"))" "find ... -delete" thumbs all
            opt "$_STALE_FILES" "$_UNTOUCHED $(conf_days cache_days 30) $_DAYS_AGO" cache
        fi

        if ((!DYNAMIC)) || [[ -n $(find "$CE_TRASH/files" "$CE_TRASH/expunged" -mindepth 1 -print -quit 2>/dev/null) ]]; then
            item "$_TRASH" "$(size_span "$tb")" trash
            sub trash "$_TRASH"
            out2+=("$_OPEN $_TRASH,pcmanfm trash://")
            bad "$_EMPTY $_TRASH" "find ... -delete" trash
        fi

        # tools whose cache dir holds data
        local dev=()
        dev_has go && dev+=(go)
        dev_has gomod && dev+=(gomod)
        dev_has npm && dev+=(npm)
        dev_has cargo && dev+=(cargo)
        dev_has pip && dev+=(pip)
        dev_has yarn && dev+=(yarn)
        dev_has pnpm && dev+=(pnpm)
        if ((${#dev[@]})); then
            item "$_DEV_CACHES" "" dev
            sub dev "$_DEV_CACHES"
            info "$_DEV_INFO"
            for t in "${dev[@]}"; do
                case $t in
                    go) opt "$_GO_BUILD_CACHE" "go clean -cache" dev go ;;
                    npm)
                        opt "npm verify" "npm cache verify" dev npm-verify
                        opt "npm clean" "npm cache clean --force" dev npm ;;
                    cargo) opt "cargo" "cargo cache --autoclean" dev cargo ;;
                    pip) opt "pip" "pip cache purge" dev pip ;;
                    yarn) opt "yarn" "yarn cache clean" dev yarn ;;
                    pnpm) opt "pnpm" "pnpm store prune" dev pnpm ;;
                    gomod) bad "$_GO_MOD_CACHE" "go clean -modcache" dev gomod ;;
                esac
            done
        fi

        local cont=()
        docker_prunable && cont+=(docker)
        flatpak_unused && cont+=(flatpak)
        snap_has_old && cont+=(snap)
        if ((${#cont[@]})); then
            item "$_CONTAINERS" "" containers
            sub containers "$_CONTAINERS"
            info "$_CONT_INFO1" "$_CONT_INFO2"
            for t in "${cont[@]}"; do
                case $t in
                    docker) opt "docker" "system prune" containers docker ;;
                    flatpak) opt "flatpak" "uninstall --unused" containers flatpak ;;
                    snap) opt "snap" "$_REMOVE_OLD_REVS" containers snap ;;
                esac
            done
        fi

        local vmn=() vml=() vmtot=0 i grp=() dh
        vm_load
        mapfile -t vmn < <(vm_ids)
        if ((${#vmn[@]})) || { ((!DYNAMIC)) && vm_dirs_exist; }; then
            for v in "${vmn[@]}"; do
                vmb=$(vm_size "$v")
                vmtot=$((vmtot + vmb))
                vml+=("$vmb $v")
            done
            item "$_VMS" "$(size_span "$vmtot")" vm
            sub vm "$_VMS"
            info "$_VM_INFO"
            if ((${#vml[@]})); then
                # one block per folder in config order, biggest VM first
                for i in "${!VMDIRS[@]}"; do
                    mapfile -t grp < <(printf '%s\n' "${vml[@]}" | awk -v p="$i:" 'index($2, p) == 1' | sort -rn)
                    ((${#grp[@]})) || continue
                    if ((${#VMDIRS[@]} > 1)); then
                        vmb=0
                        for v in "${grp[@]}"; do ((vmb += ${v%% *})); done
                        dh=${VMDIRS[i]/#$HOME/\~}
                        dh=${dh//&/"&amp;"}; dh=${dh//</"&lt;"}; dh=${dh//>/"&gt;"}; dh=${dh//)/"&#41;"}
                        out2+=("^sep(<small>$dh</small>  $(human "$vmb"))")
                    fi
                    for v in "${grp[@]}"; do
                        vmb=${v%% *}; v=${v#* }
                        opt "${v#*:}" "$(human "$vmb")  $(vm_date "$v")" vm "$v"
                    done
                done
            else
                info "$_NONE_FOUND"
            fi
        fi

        if hash pacdiff 2>/dev/null; then
            leftn=$(pacdiff -o 2>/dev/null | wc -l)
            if ((!DYNAMIC || leftn > 0)); then
                item "$_LEFTOVER" "<span> ${leftn} </span>" leftover
                sub leftover "$_PACNEW_FILES"
                info "$_LEFTOVER_INFO"
                opt "$_LIST_FILES" "pacdiff -o" leftover list
                hash meld 2>/dev/null && opt "$_REVIEW_MERGE" "pacdiff + meld" leftover merge
            fi
        fi

        # no cleanup row left: the header becomes a plain separator above Downloads
        ((DYNAMIC && ${#out[@]} == hdr + 1)) && out[hdr]="^sep()"

        downsize=$(du -sh $(xdg-user-dir DOWNLOAD)|awk '{print $1}')
        [[ "${downsize}" == *G* ]] && downsize="<span bgcolor='${WARN_BGCOLOR}' fgcolor='${WARN_FGCOLOR}'> ${downsize} </span>" || downsize="<span> ${downsize} </span>"
        out+=("\"\"\"$(basename $(xdg-user-dir DOWNLOAD))	${downsize}\"\"\",^pipe(jgbrowser $(xdg-user-dir DOWNLOAD)$qdir)")
    fi

