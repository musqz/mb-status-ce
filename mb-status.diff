+    [[ -n $before && -z $MEASURE_FN ]] && printf '%s %s\n\n' "$_A_CURRENT_SIZE" "$(human "$before")"
+    if ((${#DRY[@]})); then
+        echo "${dim}${_A_DRY_RUN}${rst}"
+        "${DRY[@]}" || true
